{
  "name": "@stonkagents/portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:temporary && npm run check:brand && next build",
    "start": "next start",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "check:brand": "node scripts/check-user-facing-brand.mjs",
    "build:land": "node scripts/build-land-json.mjs",
    "prettier:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "prettier:write": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run --bail 1",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "test:e2e:perf": "playwright test --project=perf --reporter=line",
    "check:temporary": "node scripts/check-temporary.mjs --strict",
    "contracts:sync": "node scripts/sync-contracts.mjs"
  },
  "dependencies": {
    "@raydium-io/raydium-sdk-v2": "^0.2.68-alpha",
    "@solana/connector": "^0.2.4",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-query": "^5.90.20",
    "bn.js": "^5.2.5",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "lightweight-charts": "^5.1.0",
    "next": "^15.0.0",
    "postcss": "^8.4.31",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "jsdom": "^28.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18",
    "world-atlas": "^2.0.2"
  }
}
