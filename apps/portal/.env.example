# StonkAgents portal environment.
#
# Copy to .env.local for development or .env.production for a build. Every
# value is public: Next.js inlines NEXT_PUBLIC_* into the static bundle at
# build time, so never put a secret here. Change a value, restart `next dev`.
# Unset values fall back to the defaults shown; see src/config/index.ts.

# ── Deployment ────────────────────────────────────────────────────────────────
# dev | staging | production. Dev-only surfaces (the devnet drip) show on dev.
NEXT_PUBLIC_ENV=dev
# The public hostname this build names itself by (metadata, sitemap, footer).
NEXT_PUBLIC_APP_DOMAIN=portal.example.com
NEXT_PUBLIC_APP_NAME=StonkAgents
# Injected by next.config.ts from package.json and the git sha; set to override.
# NEXT_PUBLIC_APP_VERSION=0.1.0
# NEXT_PUBLIC_BUILD_ID=local

# ── Local agent (runs on the user's machine) ──────────────────────────────────
NEXT_PUBLIC_DAEMON_URL=http://127.0.0.1:7841/api/v1
NEXT_PUBLIC_CONTROLLER_URL=http://127.0.0.1:7840
# true: talk to a running agent. false: mock data, no agent needed.
NEXT_PUBLIC_USE_REAL_DAEMON=false
# Where the installer manifest and downloads are served from.
NEXT_PUBLIC_DOWNLOAD_BASE_URL=https://releases.example.com
# The agent's data directory as shown in Settings (the agent owns the real value).
NEXT_PUBLIC_AGENT_HOME=~/.stonkagents

# ── Tracker ───────────────────────────────────────────────────────────────────
# Origin of the tracker; launch routes are <origin>/api/launch/...
NEXT_PUBLIC_TRACKER_URL=http://localhost:7842
# Older spelling of the same value, still read when NEXT_PUBLIC_TRACKER_URL is unset.
# NEXT_PUBLIC_API_BASE_URL=

# ── Solana ────────────────────────────────────────────────────────────────────
# devnet | mainnet. The one cluster switch; the wallet and the launch engine follow it.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Legacy alias (devnet | mainnet-beta); honoured only when the cluster is unset.
# NEXT_PUBLIC_SOLANA_NETWORK=devnet
# Use your own RPC: the public endpoints rate-limit the launch flow.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# NEXT_PUBLIC_SOLANA_RPC_FALLBACK_URL=
# false: launches and trades stay on the mock path, no wallet prompt.
NEXT_PUBLIC_USE_REAL_WALLET=false
NEXT_PUBLIC_EXPLORER_BASE_URL=https://solscan.io
# Appended to explorer links; empty on mainnet.
NEXT_PUBLIC_EXPLORER_CLUSTER_SUFFIX=?cluster=devnet
# Wallet that receives credit purchases (base58). The launch treasury comes from the tracker.
NEXT_PUBLIC_TREASURY_ADDRESS=11111111111111111111111111111111
# $STONK mint the launchpad quotes against; the mainnet mint when unset.
# NEXT_PUBLIC_STONK_MINT=

# ── Network token ($AGENT card on the home page) ──────────────────────────────
# NEXT_PUBLIC_AGENT_MINT=
# launchpad | stonkfun: where the token trades.
# NEXT_PUBLIC_AGENT_SOURCE=launchpad
# NEXT_PUBLIC_AGENT_POOL=
# NEXT_PUBLIC_AGENT_QUOTE_MINT=
# NEXT_PUBLIC_AGENT_BUY_URL=
# NEXT_PUBLIC_AGENT_TOTAL_SUPPLY=
# NEXT_PUBLIC_AGENT_LAUNCH_BUY_PCT=
# NEXT_PUBLIC_AGENT_TEAM_PCT=
# NEXT_PUBLIC_AGENT_BURN_TOTAL_PCT=
# NEXT_PUBLIC_AGENT_BURN_STEP_PCT=
# NEXT_PUBLIC_AGENT_BURN_INTERVAL=
# NEXT_PUBLIC_AGENT_BURN_START=
# NEXT_PUBLIC_AGENT_VESTING_LOCK_DATE=
# NEXT_PUBLIC_AGENT_VESTING_CLIFF_DATE=
# NEXT_PUBLIC_AGENT_VESTING_CADENCE=
# NEXT_PUBLIC_AGENT_VESTING_MONTHS=
# NEXT_PUBLIC_AGENT_VESTING_URL=

# ── Credits ───────────────────────────────────────────────────────────────────
# Display fallbacks for the top-up tiers; the tracker reports the real rate.
# NEXT_PUBLIC_CREDIT_TIER_STARTER_CREDITS=1000
# NEXT_PUBLIC_CREDIT_TIER_STARTER_SOL=0.02
# NEXT_PUBLIC_CREDIT_TIER_PRO_CREDITS=5000
# NEXT_PUBLIC_CREDIT_TIER_PRO_SOL=0.09
# NEXT_PUBLIC_CREDIT_TIER_ULTRA_CREDITS=20000
# NEXT_PUBLIC_CREDIT_TIER_ULTRA_SOL=0.30

# ── Outbound links and feeds ──────────────────────────────────────────────────
# NEXT_PUBLIC_SOL_PRICE_URL=https://lite-api.jup.ag/price/v3
# NEXT_PUBLIC_JUPITER_SWAP_API_URL=https://lite-api.jup.ag/swap/v1
# NEXT_PUBLIC_RAYDIUM_LAUNCHPAD_URL=https://raydium.io/launchpad
# NEXT_PUBLIC_JUPITER_URL=https://jup.ag
# NEXT_PUBLIC_DEXSCREENER_URL=https://dexscreener.com
# NEXT_PUBLIC_BIRDEYE_URL=https://birdeye.so
# Empty renders no link.
NEXT_PUBLIC_GITHUB_URL=https://github.com/stonkagents
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
# Documentation links stay hidden unless true.
NEXT_PUBLIC_DOCS_ENABLED=false
# NEXT_PUBLIC_DOCS_URL=

# ── Forms ─────────────────────────────────────────────────────────────────────
# Cloudflare Turnstile site key for the feedback forms. Empty renders no widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
